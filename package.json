{
  "name": "luma-desktop",
  "productName": "LUMA",
  "version": "0.6.2",
  "description": "LUMA music player for Windows",
  "author": "Ronaz Pradhan",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n core,ui -c magenta,cyan \"npm:dev:core\" \"npm:dev:ui\"",
    "dev:core": "node --watch core/index.js",
    "dev:ui": "vite",
    "app": "npm run build:ui && electron .",
    "build:ui": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test core/test/*.test.js",
    "dist": "npm run build:ui && electron-builder --win",
    "release": "npm run build:ui && electron-builder --win --publish always"
  },
  "dependencies": {
    "des.js": "^1.1.0",
    "electron-updater": "^6.8.9",
    "youtubei.js": "^18.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.luma.desktop",
    "productName": "LUMA",
    "copyright": "Copyright © 2026 Ronaz Pradhan",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "core/**",
      "!core/test/**",
      "dist/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "LUMA-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "LUMA",
      "uninstallDisplayName": "LUMA",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ronazpradhan",
        "repo": "luma-for-desktop",
        "releaseType": "release"
      }
    ]
  }
}
